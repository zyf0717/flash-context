explorer:
  max_turns: 6
  citation: true
  ignore:
    - ".git"
    - ".venv"
    - "node_modules"
    - "dist"
    - "build"
  # Relative paths resolve from the flash-context project root.
  traj_dir: ".flash-context"

model:
  base_url: "http://100.105.153.85:1234/v1"
  model: "Qwen/Qwen3.5-4B"
  api_key: ""
  timeout_seconds: 120
  max_completion_tokens: 512
  temperature: 0

tools:
  max_read_bytes: 12000
  max_grep_results: 50
  max_observation_chars: 6000
  max_read_lines: 120
  max_parallel_tools: 4
