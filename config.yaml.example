search:
  max_turns: 12
  max_citation_lines: 240
  max_total_citation_lines: 1200
  ignore:
    - ".git"
    - ".venv"
    - "node_modules"
    - "dist"
    - "build"
  # Relative paths resolve from the flash-context project root.
  traj_dir: null

model:
  base_url: "http://100.105.153.85:1234/v1"
  model: "Qwen/Qwen3.5-4B"
  api_key: ""
  timeout_seconds: 120
  max_completion_tokens: 4096
  temperature: 0

tools:
  max_read_bytes: 48000
  max_parse_bytes: 1048576
  max_grep_results: 100
  max_observation_chars: 24000
  max_read_lines: 480
  max_parallel_tools: 4
  max_scan_bytes: 16777216
  max_scan_entries: 10000
  tool_timeout_seconds: 5
  max_tool_calls_per_turn: 16
